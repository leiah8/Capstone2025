# Anthropic API key — required for the evaluation pipeline (eval/)
# Get yours at: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Server Configuration
PORT=8000
ENV=development

# Request timeout in seconds (prevents long-running requests from blocking resources)
REQUEST_TIMEOUT_SECONDS=30.0

# Redis Configuration (for embedding cache)
# Set REDIS_HOST to enable caching, leave empty to disable
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Redis database number (0-15)
REDIS_DB=0

# Matching Algorithm Configuration
MODEL_NAME=all-MiniLM-L6-v2
CACHE_TTL_SECONDS=86400
